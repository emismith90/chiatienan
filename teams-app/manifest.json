{
  "$schema": "https://developer.microsoft.com/en-us/json-schemas/teams/v1.16/MicrosoftTeams.schema.json",
  "manifestVersion": "1.16",
  "version": "1.0.0",
  "id": "REPLACE_WITH_MICROSOFT_APP_ID",
  "packageName": "com.hungle.chiatienan",
  "developer": {
    "name": "Hung Le",
    "websiteUrl": "https://github.com/emismith90/chiatienan",
    "privacyUrl": "https://github.com/emismith90/chiatienan/blob/main/PRIVACY.md",
    "termsOfUseUrl": "https://github.com/emismith90/chiatienan/blob/main/TERMS.md"
  },
  "name": {
    "short": "chiatienan",
    "full": "chiatienan — lunch bill splitter"
  },
  "description": {
    "short": "Splits your team's lunch bill.",
    "full": "Tag @chiatienan when you pay for lunch; the bot records it in the ledger, splits the shares, and generates VietQR codes when you settle up. All amounts and QR codes are computed by the server (never retyped by the AI)."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#4B3FBB",
  "bots": [
    {
      "botId": "REPLACE_WITH_MICROSOFT_APP_ID",
      "scopes": ["groupChat"],
      "supportsFiles": false,
      "isNotificationOnly": false
    }
  ],
  "permissions": ["identity", "messageTeamMembers"],
  "validDomains": ["chiatienan.duckdns.org"]
}
