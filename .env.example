# Copy to .env and fill in. NEVER commit .env or paste secrets in chat.
# Values must be clean KEY=VALUE (no inline comments — env_file would fold a
# trailing comment into the value).

# --- LLM engine (Pi sidecar on OpenRouter) ---
# OPEN_ROUTER_KEY (SECRET): the OpenRouter key the agent sidecar uses. Note the
# name: it is OPEN_ROUTER_KEY, not OPENROUTER_API_KEY.
OPEN_ROUTER_KEY=
# PI_MODEL: the text model. Probed against the real tool schemas, not taken from
# a catalogue's supported_parameters — see backend/bench/probe_models.py.
PI_MODEL=~deepseek/deepseek-v4-flash-latest
# PI_VISION_MODEL: mandatory in practice. PI_MODEL is text-only, so EVERY bill
# photo routes here, and an image turn with this unset fails loudly rather than
# dropping the photo (a dropped bill means the model invents the total).
PI_VISION_MODEL=qwen/qwen3-vl-30b-a3b-instruct
PI_PROVIDER=openrouter
# PI_THINKING: low | medium | high
PI_THINKING=medium
# PI_MAX_TOOLS: per-turn tool-call cap (runaway guard). A breach is a PARTIAL
# ANSWER, not an error — the turn keeps what it has and posts it normally.
PI_MAX_TOOLS=40
# PI_MAX_SECONDS: per-turn wall-clock cap, same partial-answer semantics.
PI_MAX_SECONDS=120
# DATA_DIR: SQLite + every room's long-term memory. Keep it under /data — that is
# the only mounted volume, and anything else is wiped on every deploy.
DATA_DIR=/data
# There is no base-URL setting: the OpenRouter URL is a constant in the sidecar.

# --- Bot ---
# BOT_HANDLE: the @-handle the bot answers to in room chat (e.g. "@phoenix ...").
# "@bot" always works too — it is a hardcoded legacy alias from before the
# Phoenix rebrand.
BOT_HANDLE=phoenix

# --- Storage ---
# DATABASE_URL: absolute path on the mounted volume
DATABASE_URL=sqlite:////data/chiatienan.db
TZ=Asia/Ho_Chi_Minh

# --- Admin ---
# ADMIN_PASSWORD (SECRET; you choose it): guards POST /api/rooms and /internal/bridge-smoke
ADMIN_PASSWORD=

# --- Debug/export API (deploy/DEBUGGING.md §6) ---
# DEBUG_API_KEY (SECRET): guards the read-only export routes under
# /internal/debug/* (chatlog, ledger CSVs, sanitised SQLite snapshot, app log).
# Deliberately separate from ADMIN_PASSWORD so it rotates on its own.
# LEAVE EMPTY to disable the routes entirely (they 404 as if absent).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keys shorter than 24 chars are refused (the API stays off, and logs why).
DEBUG_API_KEY=
# LOG_FILE: rotating mirror of the stdout log, so /internal/debug/logs has
# something to serve (`docker compose logs` is unreadable from inside the
# container). Empty disables the mirror; stdout logging is unaffected.
LOG_FILE=/data/logs/app.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=3

# --- VietQR image service ---
# QR_BASE_URL: {base}/{bank}-{account}-{template}.png
QR_BASE_URL=https://img.vietqr.io/image
# QR_TEMPLATE: compact | compact2 | qr_only | print
QR_TEMPLATE=compact2

# --- Deploy (Caddy auto-TLS) ---
# CADDY_DOMAIN: your domain; Caddy issues TLS for it
CADDY_DOMAIN=chiatienan.example.com
