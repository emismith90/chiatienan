# Copy to .env and fill in. NEVER commit .env or paste secrets in chat.
# Values must be clean KEY=VALUE (no inline comments — env_file would fold a
# trailing comment into the value).

# --- Cursor SDK (LLM engine) ---
# CURSOR_API_KEY (SECRET): user/service-account key (NOT a Team Admin key)
CURSOR_API_KEY=
# CURSOR_SDK_MODEL: grok-4.5-fast = grok-4.5 with effort=high, fast=true (bare grok-4.5 = fast=false)
CURSOR_SDK_MODEL=grok-4.5-fast
CURSOR_SDK_WORKSPACE=/data/cursor-agent
CURSOR_API_BASE=https://api.cursor.com
# CURSOR_AGENT_MAX_TOOLS: per-turn tool-call cap (runaway guard)
CURSOR_AGENT_MAX_TOOLS=40
# CURSOR_AGENT_MAX_SECONDS: per-turn wall-clock cap
CURSOR_AGENT_MAX_SECONDS=120

# --- Bot ---
# BOT_HANDLE: the @-handle the bot answers to in room chat (e.g. "@bot ...")
BOT_HANDLE=bot

# --- Storage ---
# DATABASE_URL: absolute path on the mounted volume
DATABASE_URL=sqlite:////data/chiatienan.db
TZ=Asia/Ho_Chi_Minh

# --- Admin ---
# ADMIN_PASSWORD (SECRET; you choose it): guards POST /api/rooms and /internal/bridge-smoke
ADMIN_PASSWORD=

# --- Debug/export API (deploy/DEBUGGING.md §6) ---
# DEBUG_API_KEY (SECRET): guards the read-only export routes under
# /internal/debug/* (chatlog, ledger CSVs, sanitised SQLite snapshot, app log).
# Deliberately separate from ADMIN_PASSWORD so it rotates on its own.
# LEAVE EMPTY to disable the routes entirely (they 404 as if absent).
# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Keys shorter than 24 chars are refused (the API stays off, and logs why).
DEBUG_API_KEY=
# LOG_FILE: rotating mirror of the stdout log, so /internal/debug/logs has
# something to serve (`docker compose logs` is unreadable from inside the
# container). Empty disables the mirror; stdout logging is unaffected.
LOG_FILE=/data/logs/app.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=3

# --- VietQR image service ---
# QR_BASE_URL: {base}/{bank}-{account}-{template}.png
QR_BASE_URL=https://img.vietqr.io/image
# QR_TEMPLATE: compact | compact2 | qr_only | print
QR_TEMPLATE=compact2

# --- Deploy (Caddy auto-TLS) ---
# CADDY_DOMAIN: your domain; Caddy issues TLS for it
CADDY_DOMAIN=chiatienan.example.com
